# Public form endpoint. Leave unset to use the included Vercel function.
VITE_CONTACT_ENDPOINT=/api/contact

# Firebase web configuration (public identifiers used only by the lazy-loaded admin app).
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional local Firebase Emulator Suite integration.
VITE_USE_FIREBASE_EMULATORS=false

# Server-only Firebase service account values used by /api/contact.
# Never prefix these with VITE_ and never commit real values.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Allowed public origins for project submissions.
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
PUBLIC_SITE_URL=https://your-domain.com

# Optional Resend notification. Inquiries are stored even if these are omitted.
RESEND_API_KEY=re_xxxxxxxxx
KATCH_CONTACT_EMAIL=projects@your-real-domain.com
RESEND_FROM_EMAIL=Katch Website <website@your-verified-domain.com>
